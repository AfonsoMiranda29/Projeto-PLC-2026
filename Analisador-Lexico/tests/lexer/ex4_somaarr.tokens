   1  PROGRAM        'PROGRAM'
   1  ID             'SOMAARR'
   1  NEWLINE        '\n'
   2  INTEGER        'INTEGER'
   2  ID             'NUMS'
   2  LPAREN         '('
   2  INT_CONST      5
   2  RPAREN         ')'
   2  NEWLINE        '\n'
   3  INTEGER        'INTEGER'
   3  ID             'I'
   3  COMMA          ','
   3  ID             'SOMA'
   3  NEWLINE        '\n'
   4  ID             'SOMA'
   4  ASSIGN         '='
   4  INT_CONST      0
   4  NEWLINE        '\n'
   5  PRINT          'PRINT'
   5  TIMES          '*'
   5  COMMA          ','
   5  STRING         'Introduza 5 numeros inteiros:'
   5  NEWLINE        '\n'
   6  DO             'DO'
   6  INT_CONST      30
   6  ID             'I'
   6  ASSIGN         '='
   6  INT_CONST      1
   6  COMMA          ','
   6  INT_CONST      5
   6  NEWLINE        '\n'
   7  READ           'READ'
   7  TIMES          '*'
   7  COMMA          ','
   7  ID             'NUMS'
   7  LPAREN         '('
   7  ID             'I'
   7  RPAREN         ')'
   7  NEWLINE        '\n'
   8  ID             'SOMA'
   8  ASSIGN         '='
   8  ID             'SOMA'
   8  PLUS           '+'
   8  ID             'NUMS'
   8  LPAREN         '('
   8  ID             'I'
   8  RPAREN         ')'
   8  NEWLINE        '\n'
   9  LABEL          30
   9  CONTINUE       'CONTINUE'
   9  NEWLINE        '\n'
  10  PRINT          'PRINT'
  10  TIMES          '*'
  10  COMMA          ','
  10  STRING         'A soma dos numeros e: '
  10  COMMA          ','
  10  ID             'SOMA'
  10  NEWLINE        '\n'
  11  END            'END'
  11  NEWLINE        '\n'
